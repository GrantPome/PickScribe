{
  "manifest_version": 3,
  "name": "PickScribe — Pickcat 富文本编辑器与 AI 助手",
  "version": "4.1.0",
  "description": "在 Pickcat 帖子编辑页注入类 Word 的可视化富文本编辑器（Markdown 双向实时同步、复用站点原生图标、粘贴净化、整站鸿蒙字体），并提供 AI 写作助手与 AI 排版（把整篇正文整理成规范 Markdown）；在帖子详情页注入 AI 总结面板与 AI 回帖助手（支持 DeepSeek / 豆包 / 通义 / Kimi / 智谱 / 硅基流动 / OpenRouter / 本地 Ollama 等 OpenAI 兼容模型）；在信息流里点击帖子直接以浮层预览详情、不切换页面；在用户主页「等级成长」弹窗显示能力 / 责任 / 爱三维度及社区熟悉度进度；并将社区站内通知转为 Windows 系统通知推送。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "notifications", "alarms"],
  "host_permissions": ["https://pickcat.dao3.fun/*", "https://cdsq.dao3.fun/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://pickcat.dao3.fun/*", "https://cdsq.dao3.fun/*"],
      "js": ["shared/desktop-bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://pickcat.dao3.fun/*", "https://cdsq.dao3.fun/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://pickcat.dao3.fun/*", "https://cdsq.dao3.fun/*"],
      "js": ["ai/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://pickcat.dao3.fun/*", "https://cdsq.dao3.fun/*"],
      "js": ["ai/reply.js"],
      "css": ["ai/reply.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://pickcat.dao3.fun/*", "https://cdsq.dao3.fun/*"],
      "js": ["home/content.js"],
      "css": ["home/home.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://pickcat.dao3.fun/*", "https://cdsq.dao3.fun/*"],
      "js": ["feed/content.js"],
      "css": ["feed/feed.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://pickcat.dao3.fun/*", "https://cdsq.dao3.fun/*"],
      "js": ["search/content.js"],
      "css": ["search/search.css"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://pickcat.dao3.fun/*", "https://cdsq.dao3.fun/*"],
      "js": ["level/content.js"],
      "css": ["level/level.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://pickcat.dao3.fun/*", "https://cdsq.dao3.fun/*"],
      "js": ["guide/guide.js"],
      "css": ["guide/guide.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://pickcat.dao3.fun/*", "https://cdsq.dao3.fun/*"],
      "js": ["api/consent.js"],
      "css": ["api/consent.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://pickcat.dao3.fun/*", "https://cdsq.dao3.fun/*"],
      "js": ["api/badge.js", "api/menu.js"],
      "css": ["api/badge.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://pickcat.dao3.fun/*", "https://cdsq.dao3.fun/*"],
      "js": ["overlay/editor.js", "overlay/content.js"],
      "css": ["overlay/overlay.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "PickScribe AI 助手",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2", "shared/font-host.html", "shared/font-host.js", "shared/guide-ai-test.html", "shared/guide-ai-test.js", "icons/logo.svg"],
      "matches": ["https://pickcat.dao3.fun/*", "https://cdsq.dao3.fun/*"]
    }
  ]
}
