{
  "manifest_version": 3,
  "name": "PickScribe — Pickcat 富文本编辑器与 AI 助手",
  "version": "3.3.1",
  "description": "在 Pickcat 帖子编辑页注入类 Word 的可视化富文本编辑器（Markdown 双向实时同步、复用站点原生图标、粘贴净化、整站鸿蒙字体）；在帖子详情页注入 AI 总结面板与 AI 回帖助手（支持 DeepSeek / 豆包 / 通义 / Kimi / 智谱 / 硅基流动 / OpenRouter / 本地 Ollama 等 OpenAI 兼容模型）；并为站点收藏夹补充分组、标签、备注与检索能力（收藏夹 Plus）。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://pickcat.dao3.fun/*", "https://cdsq.dao3.fun/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://pickcat.dao3.fun/*", "https://cdsq.dao3.fun/*"],
      "js": ["ai/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://pickcat.dao3.fun/*", "https://cdsq.dao3.fun/*"],
      "js": ["ai/reply.js"],
      "css": ["ai/reply.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://pickcat.dao3.fun/*", "https://cdsq.dao3.fun/*"],
      "js": ["home/content.js"],
      "css": ["home/home.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://pickcat.dao3.fun/*", "https://cdsq.dao3.fun/*"],
      "js": ["favorites/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "PickScribe AI 助手",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["https://pickcat.dao3.fun/*", "https://cdsq.dao3.fun/*"]
    }
  ]
}
